{
  "site": {
    "name": "Riverside Mixed Development, Millbrook",
    "description": "Fictional site investigation for a mixed-use riverside development. 16 boreholes drilled to 15-20m depth across a 250\u00d7200m area.",
    "coordinate_system": "local",
    "units": "m",
    "ground_level_datum": "AOD"
  },
  "geological_units": [
    {
      "id": 1,
      "code": "MG",
      "name": "Made Ground",
      "color": "#8B6914",
      "description": "Variable fill material including demolition rubble, ash, and reworked natural soils. Loose to medium dense. Encountered across most of the site reflecting historical industrial use.",
      "age": "20th century",
      "engineering_notes": "Variable compressibility. Not suitable as founding stratum without treatment."
    },
    {
      "id": 2,
      "code": "RTD",
      "name": "River Terrace Deposits",
      "color": "#D4A843",
      "description": "Medium dense to dense, sub-angular to sub-rounded flint GRAVEL with coarse sand. Occasional cobbles. Thickness increases toward the eastern boundary.",
      "age": "Pleistocene",
      "engineering_notes": "Good founding stratum. SPT N values typically 25-45."
    },
    {
      "id": 3,
      "code": "AC",
      "name": "Alluvial Clay",
      "color": "#4A7C59",
      "description": "Soft to firm, dark grey, silty CLAY with occasional organic laminae and shell fragments. High plasticity. Lens-like geometry controlled by former river channel.",
      "age": "Holocene",
      "engineering_notes": "Consolidation settlement risk. Cu typically 20-40 kPa. Su(rem) low."
    },
    {
      "id": 4,
      "code": "CH",
      "name": "Chalk",
      "color": "#EDE8D8",
      "description": "Soft to medium hard, white to light grey CHALK, Grade B/C (structurally weak to medium). Fractured in upper 2m. Slight flint bands at depth. Consistent across site.",
      "age": "Upper Cretaceous",
      "engineering_notes": "Check for solution features. SPT refusal common below 1.5m. Good long-term founding stratum."
    }
  ],
