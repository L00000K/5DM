{
  "site": {
    "name": "Riverside Development, Millbrook",
    "description": "Mixed-use development site on the River Mill floodplain, 250\u00d7190m. Site underlain by River Terrace Deposits (RTD) cut by a NW-SE trending palaeochannel filled with soft Alluvial Clay Lens (ACL). A normal E-W fault at ~95m north of site origin drops the Chalk bedrock 3.5m on the north block. London Clay (SC) underlies the RTD across the site.",
    "constraints": "Made ground not deeper than 2m\nAlluvial Clay Lens exists only in the central west half\nChalk is above 4mAOD in south \u2014 faulted below 0mAOD in north\nThere is a normal fault running east-west at 95m north"
  },
  "geological_units": [
    {
      "id": 1,
      "code": "MG",
      "name": "Made Ground",
      "color": "#7a6a42",
      "description": "Firm brown sandy fill with brick, tile and ash. Variable thickness. Historical development."
    },
    {
      "id": 2,
      "code": "RTD",
      "name": "River Terrace Deposits",
      "color": "#D4A843",
      "description": "Dense sub-angular flint gravel in sandy matrix. Holocene\u2013Pleistocene. Thickness 2.5\u20134m. Good drainage."
    },
    {
      "id": 3,
      "code": "ACL",
      "name": "Alluvial Clay Lens",
      "color": "#4A7C59",
      "description": "Soft dark grey silty clay with organic laminae. Palaeochannel infill, NW-SE trending. Cu ~15\u201325 kPa. Compressible \u2014 significant settlement risk."
    },
    {
      "id": 4,
      "code": "SC",
      "name": "Stiff Clay",
      "color": "#4a6fa5",
      "description": "Stiff to very stiff grey-brown fissured London Clay. High plasticity. Cu 80\u2013180 kPa. Eocene. Displaced vertically 3.5m by normal fault."
    },
    {
      "id": 5,
      "code": "CH",
      "name": "Chalk",
      "color": "#EDE8D8",
      "description": "White to off-white moderately strong Chalk, Grade III\u2013IV. Cretaceous. Top at ~2.5 mAOD south of fault; drops to ~\u22120.8 mAOD north. Reliable founding stratum."
    }
  ],
